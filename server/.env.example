# TripMate Backend Environment Configuration
PORT=5000

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/tripmate
# Production MongoDB (e.g. MongoDB Atlas for Render):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tripmate?retryWrites=true&w=majority

# JWT Authentication Secret Key (replace with strong secret in production):
JWT_SECRET=tripmate_production_secret_key_change_me
